{
  "_comment": "Engine conformance corpus. Read by BOTH backend/tests/test_spec_engine.py and frontend/src/utils/__tests__/citationEngine.test.js. A miniature spec, so the engine's behaviour is pinned independent of the real Bluebook data. If the two engines ever disagree, one of those suites fails.",
  "spec": {
    "types": [
      {
        "id": "demo_report",
        "label": "Demo report",
        "priority": 5,
        "patterns": [
          {
            "regex": "(?P<author>[A-Z][A-Za-z.' ]+?),\\s*(?P<number>GAO-\\d{2}-\\d+),\\s*(?P<title>[^()]+?)\\s*\\((?P<year>\\d{4})\\)",
            "flags": ""
          },
          {
            "regex": "(?P<author>[A-Z][A-Za-z.' ]+?),\\s*(?P<number>GAO-\\d{2}-\\d+),\\s*(?P<title>[A-Za-z][^()]+)",
            "flags": ""
          },
          {
            "regex": "(?P<number>GAO-\\d{2}-\\d+)",
            "flags": ""
          }
        ],
        "fields": [
          {
            "name": "author",
            "label": "author",
            "rule": "R1",
            "why": "who wrote it",
            "required": true
          },
          {
            "name": "number",
            "label": "report number",
            "rule": "R2",
            "why": "the number",
            "required": true
          },
          {
            "name": "title",
            "label": "title",
            "rule": "R3",
            "why": "the title",
            "required": true
          },
          {
            "name": "year",
            "label": "year",
            "rule": "R4",
            "why": "the year",
            "required": true
          }
        ],
        "templates": {
          "law_review": "{author|smallcaps}, {number}, {title|smallcaps} ({year}).",
          "practitioner": "{author}, {number}, {title|italic} ({year})."
        }
      },
      {
        "id": "demo_amendment",
        "label": "Demo amendment",
        "priority": 5,
        "patterns": [
          {
            "regex": "U\\.?S\\.? Const\\.? amend\\.? (?P<amendment>[IVXLC]+)(?:,?\\s*§\\s*(?P<section>\\d+))?(?:,?\\s*cl\\.\\s*(?P<clause>\\d+))?",
            "flags": "i"
          }
        ],
        "fields": [
          {
            "name": "amendment",
            "label": "amendment number",
            "rule": "R5",
            "why": "which amendment",
            "required": true
          },
          {
            "name": "section",
            "label": "section",
            "rule": "R6",
            "why": "which section",
            "required": false
          },
          {
            "name": "clause",
            "label": "clause",
            "rule": "R7",
            "why": "which clause",
            "required": false
          }
        ],
        "templates": {
          "law_review": "U.S. Const. amend. {amendment|roman}<<, § {section}>><<, cl. {clause}>>."
        }
      },
      {
        "id": "demo_seam",
        "label": "Demo seam",
        "priority": 1,
        "patterns": [
          {
            "regex": "(?P<a>S\\d)(?:-(?P<b>T\\d))?-(?P<c>U\\d)",
            "flags": ""
          }
        ],
        "fields": [
          {
            "name": "a",
            "label": "a",
            "rule": "",
            "why": "",
            "required": true
          },
          {
            "name": "b",
            "label": "b",
            "rule": "",
            "why": "",
            "required": false
          },
          {
            "name": "c",
            "label": "c",
            "rule": "",
            "why": "",
            "required": true
          }
        ],
        "templates": {
          "law_review": "{a}<< ({b})>> {c} <<[{b}]>>."
        }
      }
    ]
  },
  "match_cases": [
    {
      "name": "a complete report, law review style",
      "input": "U.S. Gov't Accountability Off., GAO-16-552, Firearms Data (2016)",
      "style": "law_review",
      "type_id": "demo_report",
      "missing": [],
      "formatted": "U.S. GOV'T ACCOUNTABILITY OFF., GAO-16-552, FIREARMS DATA (2016).",
      "template": "U.S. GOV'T ACCOUNTABILITY OFF., GAO-16-552, FIREARMS DATA (2016)."
    },
    {
      "name": "the same report, practitioner style",
      "input": "U.S. Gov't Accountability Off., GAO-16-552, Firearms Data (2016)",
      "style": "practitioner",
      "type_id": "demo_report",
      "missing": [],
      "formatted": "U.S. Gov't Accountability Off., GAO-16-552, *Firearms Data* (2016).",
      "template": "U.S. Gov't Accountability Off., GAO-16-552, *Firearms Data* (2016)."
    },
    {
      "name": "a report with no year is not formatted, and the gap is marked",
      "input": "U.S. Gov't Accountability Off., GAO-16-552, Firearms Data",
      "style": "law_review",
      "type_id": "demo_report",
      "missing": [
        "year"
      ],
      "formatted": null,
      "template": "U.S. GOV'T ACCOUNTABILITY OFF., GAO-16-552, FIREARMS DATA ([year])."
    },
    {
      "name": "only a report number is known: everything else is a gap",
      "input": "GAO-16-552",
      "style": "law_review",
      "type_id": "demo_report",
      "missing": [
        "author",
        "title",
        "year"
      ],
      "formatted": null,
      "template": "[author], GAO-16-552, [title] ([year])."
    },
    {
      "name": "optional blocks are dropped when their field is absent",
      "input": "U.S. Const. amend. XIV",
      "style": "law_review",
      "type_id": "demo_amendment",
      "missing": [],
      "formatted": "U.S. Const. amend. XIV.",
      "template": "U.S. Const. amend. XIV."
    },
    {
      "name": "optional blocks are included when present, in order",
      "input": "U.S. Const. amend. XIV, § 1",
      "style": "law_review",
      "type_id": "demo_amendment",
      "missing": [],
      "formatted": "U.S. Const. amend. XIV, § 1.",
      "template": "U.S. Const. amend. XIV, § 1."
    },
    {
      "name": "two optional blocks together",
      "input": "US Const amend xiv, § 2, cl. 3",
      "style": "law_review",
      "type_id": "demo_amendment",
      "missing": [],
      "formatted": "U.S. Const. amend. XIV, § 2, cl. 3.",
      "template": "U.S. Const. amend. XIV, § 2, cl. 3."
    },
    {
      "name": "a style with no template of its own falls back to law review",
      "input": "U.S. Const. amend. I",
      "style": "practitioner",
      "type_id": "demo_amendment",
      "missing": [],
      "formatted": "U.S. Const. amend. I.",
      "template": "U.S. Const. amend. I."
    },
    {
      "name": "prose that merely contains a fragment is not a citation",
      "input": "Please explain why the report numbered GAO-16-552 matters to the argument in the second section of the brief",
      "style": "law_review",
      "type_id": null,
      "missing": null,
      "formatted": null,
      "template": null
    },
    {
      "name": "nothing recognisable",
      "input": "hello world",
      "style": "law_review",
      "type_id": null,
      "missing": null,
      "formatted": null,
      "template": null
    },
    {
      "name": "dropping optional blocks leaves no stray spaces or doubled spaces",
      "input": "S1-U3",
      "style": "law_review",
      "type_id": "demo_seam",
      "missing": [],
      "formatted": "S1 U3.",
      "template": "S1 U3."
    },
    {
      "name": "present optional blocks keep their own spacing",
      "input": "S1-T2-U3",
      "style": "law_review",
      "type_id": "demo_seam",
      "missing": [],
      "formatted": "S1 (T2) U3 [T2].",
      "template": "S1 (T2) U3 [T2]."
    }
  ],
  "find_all_cases": [
    {
      "name": "two citations of different types in running text, in document order",
      "input": "As held in U.S. Const. amend. XIV, § 1 and reported in U.S. Gov't Accountability Off., GAO-16-552, Firearms Data (2016), the rule is settled.",
      "expected": [
        {
          "type_id": "demo_amendment",
          "text": "U.S. Const. amend. XIV, § 1"
        },
        {
          "type_id": "demo_report",
          "text": "U.S. Gov't Accountability Off., GAO-16-552, Firearms Data (2016)"
        }
      ]
    },
    {
      "name": "a longer match swallows the shorter fragment inside it",
      "input": "U.S. Gov't Accountability Off., GAO-16-552, Firearms Data (2016)",
      "expected": [
        {
          "type_id": "demo_report",
          "text": "U.S. Gov't Accountability Off., GAO-16-552, Firearms Data (2016)"
        }
      ]
    },
    {
      "name": "no citations",
      "input": "Nothing to see here.",
      "expected": []
    }
  ],
